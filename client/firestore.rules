rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && 
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Public catalog collections — public read, authenticated/admin write
    match /mandhi_shops/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /districts/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /mandhi_types/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /reviews/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /quiz_questions/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /quiz_results/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /communities/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /community_members/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /community_messages/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /notifications/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /favorites/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /shop_images/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Fallback catch-all for system audit
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
