rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{docId} {
      allow read, list, create, update, delete, write: if isAuthenticated();
    }

    match /mandhi_shops/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /districts/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /categories/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /mandhi_types/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /reviews/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /gallery/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /quiz_questions/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /quiz_results/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /communities/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /community_members/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /community_messages/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /notifications/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /site_settings/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /ai_conversations/{docId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /{document=**} {
      allow read, list, create, update, delete, write: if isAuthenticated();
    }
  }
}
