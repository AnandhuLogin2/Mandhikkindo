rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Public catalog collections — public read, authenticated write
    match /mandhi_shops/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /districts/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /mandhi_types/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /reviews/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /quiz_questions/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /quiz_results/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /communities/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /community_members/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /community_messages/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /notifications/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /favorites/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /shop_images/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Catch-all for all other collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
